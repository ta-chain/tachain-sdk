{
    "name": "ta-chain/tachain-sdk",
    "description": "Public integration endpoints. Set your own base URL and credential before calling.",
    "keywords": [
        "openapitools",
        "openapi-generator",
        "openapi",
        "php",
        "sdk",
        "rest",
        "api"
    ],
    "homepage": "https://github.com/ta-chain/tachain-sdk-php",
    "license": "MIT",
    "authors": [
        {
            "name": "Tactic Chain contributors"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "TachainSdk\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TachainSdk\\Test\\": "test/"
        }
    }
}
